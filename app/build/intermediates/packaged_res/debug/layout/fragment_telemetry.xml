<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="飞行器状态"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="连接状态: --" />

        <TextView
            android:id="@+id/textFlightMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="飞行模式: --" />

        <TextView
            android:id="@+id/textBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="电量: --" />

        <TextView
            android:id="@+id/textGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS信号: --" />

        <TextView
            android:id="@+id/textFlying"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="飞行状态: --" />

        <TextView
            android:id="@+id/textMotors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="电机状态: --" />

        <TextView
            android:id="@+id/textFlightTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="飞行时间: --" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#CCCCCC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="飞行遥测"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="位置: --, --" />

        <TextView
            android:id="@+id/textAltitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="相对高度: -- m" />

        <TextView
            android:id="@+id/textUltrasonic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="超声波高度: -- m" />

        <TextView
            android:id="@+id/textTakeoffAlt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="起飞高度: -- m" />

        <TextView
            android:id="@+id/textAttitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="姿态: P:-- R:-- Y:-- " />

        <TextView
            android:id="@+id/textVelocity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="速度: X:-- Y:-- Z:-- " />

    </LinearLayout>

</ScrollView>